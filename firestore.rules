rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.rol in ['superadmin', 'admin_gh'];
    }

    function isSameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function sameCompany(resourceData) {
      return isSignedIn() && userDoc().data.empresaId == resourceData.empresaId;
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn() && (isSameUser(userId) || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSameUser(userId) && request.resource.data.rol == resource.data.rol);
      allow delete: if isAdmin();
    }

    match /empleados/{empleadoId} {
      allow read: if isSignedIn() && (isAdmin() || sameCompany(resource.data));
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /cargos/{cargoId} {
      allow read: if isSignedIn() && (isAdmin() || sameCompany(resource.data));
      allow create, update, delete: if isAdmin();
    }

    match /solicitudes/{solicitudId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.empleadoId == userDoc().data.empleadoId ||
        sameCompany(resource.data)
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        resource.data.empleadoId == userDoc().data.empleadoId &&
        request.resource.data.estado == resource.data.estado
      );
      allow delete: if isAdmin();
    }

    match /nomina/{periodoId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
