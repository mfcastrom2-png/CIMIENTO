rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares de autenticación y roles
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function hasRole(roles) {
      return signedIn() && (
        request.auth.token.email in ['mf.castrom2@gmail.com'] ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         currentUser().data.rol in roles)
      );
    }

    function isAdmin() {
      return hasRole(['superadmin', 'admin_gh']);
    }

    function isSSTorAdmin() {
      return hasRole(['superadmin', 'admin_gh', 'responsable_sst']);
    }

    // Aislamiento Multi-Tenant estricto
    function sameCompany(data) {
      return signedIn() && (
        request.auth.token.email in ['mf.castrom2@gmail.com'] ||
        hasRole(['superadmin']) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         (!('empresaId' in data) || data.empresaId == currentUser().data.empresaId))
      );
    }

    // 0. Conectividad y verificación de estado
    match /test/connection {
      allow read: if true;
    }

    // 1. Configuración de la Empresa y Parámetros
    match /configuracion_empresa/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /configuracion_nomina/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 2. Usuarios del Sistema (Protección de roles e inmutabilidad de privilegios)
    match /usuarios/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.permisos == resource.data.permisos
          && request.resource.data.empresaId == resource.data.empresaId
        );

      allow delete: if hasRole(['superadmin']);
    }

    // 3. Empleados (Aislamiento por empresa)
    match /empleados/{empleadoId} {
      allow read: if isAdmin() || sameCompany(resource.data);
      allow create: if isAdmin() && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow update: if isAdmin()
        && sameCompany(resource.data)
        && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow delete: if hasRole(['superadmin'])
        && sameCompany(resource.data);
    }

    // 4. Cargos, Áreas y Procesos Organizacionales (Aislamiento Multi-Tenant)
    match /cargos/{cargoId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isAdmin() && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow update: if isAdmin()
        && sameCompany(resource.data)
        && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    match /areas/{areaId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isAdmin() && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow update: if isAdmin()
        && sameCompany(resource.data)
        && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    match /procesos/{procesoId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isAdmin() && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow update: if isAdmin()
        && sameCompany(resource.data)
        && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    // 5. Inventario de EPP
    match /inventario_epp/{eppId} {
      allow read: if signedIn();
      allow write: if isSSTorAdmin();
    }

    // 6. Solicitudes y Entregas de EPP
    match /solicitudes_epp/{solicitudId} {
      allow read: if isSSTorAdmin()
        || (signedIn() && sameCompany(resource.data) && (
          resource.data.empleadoId == currentUser().data.empleadoId ||
          resource.data.empleadoEmail == request.auth.token.email
        ));
      allow create: if signedIn() && sameCompany(request.resource.data);
      allow update: if isSSTorAdmin() && sameCompany(resource.data);
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    // 7. Solicitudes Laborales (Vacaciones, Permisos, Incapacidades)
    match /solicitudes/{solicitudId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && sameCompany(resource.data)
          && (
            resource.data.empleadoId == currentUser().data.empleadoId ||
            resource.data.empleadoEmail == request.auth.token.email
          )
        );

      allow create: if signedIn()
        && sameCompany(request.resource.data);

      allow update: if isAdmin()
        && sameCompany(resource.data)
        && sameCompany(request.resource.data);

      allow delete: if isAdmin()
        && sameCompany(resource.data);
    }

    // 7.1 Control de Vacaciones
    match /vacaciones/{vacacionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 7.2 Procesos de Votación SST
    match /votaciones_sst/{votacionId} {
      allow read: if signedIn();
      allow write: if isSSTorAdmin();
    }

    // 8. Evaluaciones de Desempeño
    match /evaluaciones/{evaluacionId} {
      allow read: if isSSTorAdmin()
        || (signedIn() && sameCompany(resource.data) && (
          resource.data.empleadoId == currentUser().data.empleadoId ||
          resource.data.evaluadorId == request.auth.uid
        ));
      allow write: if isSSTorAdmin() && sameCompany(request.resource.data);
    }

    // 9. Nómina y Pagos (Aislamiento confidencial estricto CST)
    match /nominas/{nominaId} {
      allow read: if (isAdmin() && sameCompany(resource.data))
        || (signedIn() && sameCompany(resource.data) && (
          resource.data.empleadoEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        ));
      allow write: if isAdmin()
        && sameCompany(request.resource.data);
    }

    // 10. Capacitaciones y Exámenes
    match /capacitaciones/{capId} {
      allow read: if signedIn();
      allow write: if isSSTorAdmin();
    }

    // 11. Auditoría Inmutable
    match /logs_auditoria/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
