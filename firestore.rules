rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares de autenticación y roles
    function signedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return signedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function currentUser() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Verificación de roles basada estrictamente en Custom Claims o documento seguro en Firestore
    function hasRole(roles) {
      return signedIn() && (
        (request.auth.token.role != null && request.auth.token.role in roles) ||
        (request.auth.token.superadmin == true && 'superadmin' in roles) ||
        (request.auth.token.admin_gh == true && 'admin_gh' in roles) ||
        (request.auth.token.responsable_sst == true && 'responsable_sst' in roles) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         currentUser().data.rol in roles)
      );
    }

    function isAdmin() {
      return hasRole(['superadmin', 'admin_gh']);
    }

    function isSSTorAdmin() {
      return hasRole(['superadmin', 'admin_gh', 'responsable_sst']);
    }

    // Aislamiento Multi-Tenant estricto (Previene vulnerabilidad de coincidencia '' == '')
    function sameCompany(data) {
      return signedIn() && (
        hasRole(['superadmin']) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         ('empresaId' in data) &&
         data.empresaId != null &&
         data.empresaId != '' &&
         ('empresaId' in currentUser().data) &&
         currentUser().data.empresaId != null &&
         currentUser().data.empresaId != '' &&
         data.empresaId == currentUser().data.empresaId)
      );
    }

    // 0. Conectividad y verificación de estado
    match /test/connection {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 1. Configuración de la Empresa y Parámetros (Protegido por empresa / admin)
    match /configuracion_empresa/{docId} {
      allow read: if isAdmin() || (signedIn() && docId == currentUser().data.empresaId && currentUser().data.empresaId != '') || sameCompany(resource.data);
      allow write: if isAdmin() && (hasRole(['superadmin']) || sameCompany(request.resource.data));
    }

    match /configuracion_nomina/{docId} {
      allow read, write: if isAdmin() && (hasRole(['superadmin']) || sameCompany(resource.data));
    }

    // 2. Usuarios del Sistema (Protección de roles e inmutabilidad de privilegios)
    // El auto-registro de usuario nuevo siempre se restringe a rol: 'empleado' y sin empresaId preasignado
    match /usuarios/{uid} {
      allow read: if isAdmin()
        || (signedIn() && (request.auth.uid == uid || (isEmailVerified() && resource.data.email == request.auth.token.email)));

      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && (!('rol' in request.resource.data) || request.resource.data.rol == 'empleado')
          && (!('empresaId' in request.resource.data) || request.resource.data.empresaId == '')
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.permisos == resource.data.permisos
          && request.resource.data.empresaId == resource.data.empresaId
        );

      allow delete: if hasRole(['superadmin']);
    }

    // 3. Empleados (Aislamiento por empresa)
    match /empleados/{empleadoId} {
      allow read: if isAdmin() || sameCompany(resource.data);
      allow create: if isAdmin() && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow update: if isAdmin()
        && sameCompany(resource.data)
        && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow delete: if isAdmin()
        && sameCompany(resource.data);
    }

    // 4. Cargos, Áreas y Procesos Organizacionales (Aislamiento por empresa)
    match /cargos/{cargoId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isAdmin() && sameCompany(request.resource.data);
      allow update: if isAdmin() && sameCompany(resource.data) && sameCompany(request.resource.data);
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    match /areas/{areaId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isAdmin() && sameCompany(request.resource.data);
      allow update: if isAdmin() && sameCompany(resource.data) && sameCompany(request.resource.data);
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    match /procesos/{procesoId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isAdmin() && sameCompany(request.resource.data);
      allow update: if isAdmin() && sameCompany(resource.data) && sameCompany(request.resource.data);
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    // 5. Inventario de EPP (Aislamiento Multi-Tenant)
    match /inventario_epp/{eppId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isSSTorAdmin() && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow update: if isSSTorAdmin()
        && sameCompany(resource.data)
        && (sameCompany(request.resource.data) || !('empresaId' in request.resource.data));
      allow delete: if isSSTorAdmin() && sameCompany(resource.data);
    }

    // 6. Solicitudes y Entregas de EPP
    match /solicitudes_epp/{solicitudId} {
      allow read: if isSSTorAdmin()
        || (signedIn() && sameCompany(resource.data) && (
          resource.data.empleadoId == currentUser().data.empleadoId ||
          (isEmailVerified() && resource.data.empleadoEmail == request.auth.token.email)
        ));
      allow create: if signedIn() && sameCompany(request.resource.data);
      allow update: if isSSTorAdmin() && sameCompany(resource.data);
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    // 7. Solicitudes Laborales (Vacaciones, Permisos, Incapacidades, Certificados)
    match /solicitudes/{solicitudId} {
      allow read: if signedIn() && sameCompany(resource.data);

      allow create: if signedIn()
        && sameCompany(request.resource.data)
        && (isAdmin() || request.resource.data.estado == 'Pendiente' || request.resource.data.estado == 'Radicada');

      allow update: if isAdmin()
        && sameCompany(resource.data)
        && sameCompany(request.resource.data);

      allow delete: if isAdmin()
        && sameCompany(resource.data);
    }

    // 7.1 Control de Vacaciones (Aislamiento por empresa)
    match /vacaciones/{vacacionId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isAdmin() && sameCompany(request.resource.data);
      allow update: if isAdmin() && sameCompany(resource.data) && sameCompany(request.resource.data);
      allow delete: if isAdmin() && sameCompany(resource.data);
    }

    // 7.2 Procesos de Votación SST (Aislamiento por empresa)
    match /votaciones_sst/{votacionId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create: if isSSTorAdmin() && sameCompany(request.resource.data);
      allow update: if isSSTorAdmin() && sameCompany(resource.data) && sameCompany(request.resource.data);
      allow delete: if isSSTorAdmin() && sameCompany(resource.data);
    }

    // 8. Evaluaciones de Desempeño
    match /evaluaciones/{evaluacionId} {
      allow read: if isSSTorAdmin()
        || (signedIn() && sameCompany(resource.data) && (
          resource.data.empleadoId == currentUser().data.empleadoId ||
          resource.data.evaluadorId == request.auth.uid
        ));
      allow write: if isSSTorAdmin() && sameCompany(request.resource.data);
    }

    // 9. Nómina y Pagos (Aislamiento confidencial estricto CST)
    match /nominas/{nominaId} {
      allow read: if (isAdmin() && sameCompany(resource.data))
        || (signedIn() && sameCompany(resource.data) && isEmailVerified() && (
          resource.data.empleadoEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        ));
      allow write: if isAdmin()
        && sameCompany(request.resource.data);
    }

    // 9.1 Consolidado de Períodos de Nómina
    match /periodos_nomina/{periodoId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow write: if isAdmin() && sameCompany(request.resource.data);
    }

    // 10. Capacitaciones y Exámenes (Plan Anual - Admin/SST edita cursos; Colaboradores registran asistencia/examen)
    match /capacitaciones/{capId} {
      allow read: if signedIn() && sameCompany(resource.data);
      allow create, delete: if isSSTorAdmin() && sameCompany(request.resource.data);
      allow update: if (isSSTorAdmin() && sameCompany(request.resource.data)) || (
        sameCompany(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantes', 'updatedAt'])
      );
    }

    // 11. Auditoría Inmutable del Sistema (Append-only no falsificable)
    match /auditoria_sistema/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn() && (
        ('usuario' in request.resource.data && 'uid' in request.resource.data.usuario && request.resource.data.usuario.uid == request.auth.uid) ||
        ('usuarioId' in request.resource.data && request.resource.data.usuarioId == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /logs_auditoria/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn() && (
        'usuarioId' in request.resource.data && request.resource.data.usuarioId == request.auth.uid
      );
      allow update, delete: if false;
    }

    // 12. Tablero de Anuncios y Slides (Muro de Noticias Institucionales con aislamiento)
    match /anuncios_slides/{anuncioId} {
      allow read: if sameCompany(resource.data);
      allow write: if isSSTorAdmin() && sameCompany(request.resource.data);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
