{
  "entities": {
    "Empleado": {
      "collection": "empleados",
      "fields": {
        "id": { "type": "string", "description": "Identificador único del empleado" },
        "nombre": { "type": "string", "description": "Nombre completo" },
        "documento": { "type": "string", "description": "Número de identificación C.C." },
        "cargoId": { "type": "string", "description": "ID del cargo asociado" },
        "areaId": { "type": "string", "description": "ID del área organizacional" },
        "email": { "type": "string", "description": "Correo institucional" },
        "telefono": { "type": "string", "description": "Teléfono de contacto" },
        "fechaIngreso": { "type": "string", "description": "Fecha de inicio del contrato" },
        "salario": { "type": "number", "description": "Salario base mensual" },
        "estado": { "type": "string", "description": "Activo, Inactivo, Vacaciones" },
        "tallas": { "type": "object", "description": "Tallas de camisa, pantalón, calzado" }
      }
    },
    "Cargo": {
      "collection": "cargos",
      "fields": {
        "id": { "type": "string", "description": "Identificador único del cargo" },
        "nombre": { "type": "string", "description": "Nombre del cargo" },
        "areaId": { "type": "string", "description": "Área a la que pertenece" },
        "salarioBase": { "type": "number", "description": "Salario de referencia" }
      }
    },
    "InventarioEPP": {
      "collection": "inventario_epp",
      "fields": {
        "id": { "type": "string", "description": "ID único del artículo EPP" },
        "codigo": { "type": "string", "description": "Código interno de almacén" },
        "nombre": { "type": "string", "description": "Nombre descriptivo del EPP" },
        "categoria": { "type": "string", "description": "Categoría de protección corporal" },
        "normaTecnica": { "type": "string", "description": "Norma ANSI / NTC / OSHA" },
        "stockActual": { "type": "number", "description": "Cantidad física en almacén" },
        "stockMinimo": { "type": "number", "description": "Umbral de reposición" },
        "unidadMedida": { "type": "string", "description": "Par, Unidad, Kit" },
        "vidaUtilMeses": { "type": "number", "description": "Durabilidad estimada" }
      }
    },
    "SolicitudEntregaEPP": {
      "collection": "solicitudes_epp",
      "fields": {
        "id": { "type": "string", "description": "ID único de la entrega" },
        "codigoSolicitud": { "type": "string", "description": "Código consecutivo" },
        "empleadoId": { "type": "string", "description": "ID del colaborador receptor" },
        "eppId": { "type": "string", "description": "ID del EPP entregado" },
        "cantidad": { "type": "number", "description": "Cantidad entregada" },
        "fechaSolicitud": { "type": "string", "description": "Fecha de registro" },
        "fechaEntrega": { "type": "string", "description": "Fecha de despacho físico" },
        "estado": { "type": "string", "description": "Pendiente, Aprobada, Entregada, Rechazada" },
        "responsableEntrega": { "type": "string", "description": "Responsable de almacén/SST" },
        "actaEntregaNumero": { "type": "string", "description": "Número consecutivo de acta" },
        "firmaConformidadTrabajador": { "type": "boolean", "description": "Firma del trabajador" }
      }
    },
    "UsuarioSistema": {
      "collection": "usuarios",
      "fields": {
        "id": { "type": "string", "description": "UID de Firebase Auth" },
        "email": { "type": "string", "description": "Correo institucional" },
        "nombre": { "type": "string", "description": "Nombre completo" },
        "rol": { "type": "string", "description": "superadmin, admin_gh, responsable_sst, empleado" },
        "estado": { "type": "string", "description": "activo o inactivo" }
      }
    },
    "AuditoriaSistema": {
      "collection": "auditoria_sistema",
      "fields": {
        "id": { "type": "string", "description": "ID único del evento de auditoría" },
        "timestamp": { "type": "string", "description": "Marca de tiempo ISO del evento" },
        "accion": { "type": "string", "description": "CREACION, ACTUALIZACION, ELIMINACION, EXPORTACION, CIERRE_PERIODO" },
        "entidad": { "type": "string", "description": "empleados, cargos, nominas, usuarios, epp, etc." },
        "entidadId": { "type": "string", "description": "Identificador del registro afectado" },
        "detalle": { "type": "string", "description": "Descripción humana detallada del cambio" },
        "datosAnteriores": { "type": "object", "description": "Snapshot opcional previo al cambio" },
        "datosNuevos": { "type": "object", "description": "Snapshot opcional con los nuevos valores" },
        "usuario": { "type": "object", "description": "Detalles del usuario que ejecutó la acción: uid, email, nombre, rol" },
        "empresaId": { "type": "string", "description": "Identificador de la empresa para segregación multi-tenant" }
      }
    },
    "AnuncioSlide": {
      "collection": "anuncios_slides",
      "fields": {
        "id": { "type": "string", "description": "ID único del slide o anuncio" },
        "titulo": { "type": "string", "description": "Título principal del anuncio" },
        "subtitulo": { "type": "string", "description": "Subtítulo o bajada informativa" },
        "categoria": { "type": "string", "description": "Categoría temática (SG-SST, Bienestar, Capacitación, etc.)" },
        "imagenUrl": { "type": "string", "description": "URL de la imagen del banner o slide" },
        "descripcion": { "type": "string", "description": "Texto detallado del comunicado" },
        "fechaPublicacion": { "type": "string", "description": "Fecha de publicación" },
        "vigenciaHasta": { "type": "string", "description": "Fecha de vencimiento opcional" },
        "activo": { "type": "boolean", "description": "Estado de publicación para portal de empleado" },
        "orden": { "type": "number", "description": "Prioridad u orden de visualización" },
        "autorNombre": { "type": "string", "description": "Área o funcionario emisor" },
        "linkAccion": { "type": "string", "description": "Ruta interna o enlace de acción sugerida" },
        "textoBoton": { "type": "string", "description": "Texto del botón de acción" },
        "destacado": { "type": "boolean", "description": "Indica si es anuncio prioritario en carrusel" }
      }
    },
    "Capacitacion": {
      "collection": "capacitaciones",
      "fields": {
        "id": { "type": "string", "description": "ID único de la capacitación (ej. CAP-2026-001)" },
        "codigo": { "type": "string", "description": "Código formal del curso o estándar formativo" },
        "titulo": { "type": "string", "description": "Título temático de la capacitación" },
        "objetivo": { "type": "string", "description": "Objetivo de aprendizaje y competencias a desarrollar" },
        "tipo": { "type": "string", "description": "SST, Técnica, Habilidades Blandas, Normativa y Cumplimiento, Gestión Operativa" },
        "facilitador": { "type": "string", "description": "Nombre del facilitador o especialista capacitador" },
        "entidadFacilitadora": { "type": "string", "description": "Entidad o empresa que imparte la formación (ARL, externa o propia)" },
        "duracionHoras": { "type": "number", "description": "Intensidad horaria certificable" },
        "modalidad": { "type": "string", "description": "Presencial, Virtual sincrónica, Asincrónica, Mixta" },
        "fechaProgramada": { "type": "string", "description": "Fecha programada de la sesión (YYYY-MM-DD)" },
        "horaInicio": { "type": "string", "description": "Hora de inicio de la capacitación" },
        "lugarOEnlace": { "type": "string", "description": "Ubicación física o enlace de videoconferencia/material" },
        "cargosAsignados": { "type": "array", "description": "Lista de IDs de cargos o ['TODOS']" },
        "estado": { "type": "string", "description": "Programada, En ejecución, Finalizada, Cancelada" },
        "examenConocimiento": { "type": "object", "description": "Evaluación con nota mínima, tiempo y banco de preguntas con retroalimentación" },
        "participantes": { "type": "array", "description": "Registros individuales de asistencia, calificación, certificado y estado" }
      }
    }
  }
}
