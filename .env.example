# ==============================================================================
# CIMIENTO - GESTIÓN HUMANA | VARIABLES DE ENTORNO CLIENTE (VITE)
# ==============================================================================

# VITE_SENTRY_DSN: DSN de Sentry para telemetría de errores y monitoreo en producción.
# Si se deja vacío, la inicialización de Sentry se deshabilita automáticamente.
VITE_SENTRY_DSN=""

# VITE_RECAPTCHA_SITE_KEY: Clave de sitio de reCAPTCHA Enterprise para Firebase App Check.
# Protege las llamadas de Cloud Firestore contra bots, scrapers y accesos no autorizados.
VITE_RECAPTCHA_SITE_KEY=""

# VITE_APPCHECK_DEBUG_TOKEN: Token de depuración para permitir desarrollo local/pruebas
# sin requerir resolver el desafío de reCAPTCHA en localhost.
VITE_APPCHECK_DEBUG_TOKEN=""
